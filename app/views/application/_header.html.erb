<header class="py-2 text-bg-dark">
  <nav class="navbar navbar-expand-lg bg-dark" data-bs-theme="dark">
    <div class="container">
      <a class="navbar-brand me-5" href="<%= root_path %>">Filamentory</a>

      <div class="collapse navbar-collapse">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><%= link_to "Inventory", root_path, class: ["nav-link", "active": current_page?(root_path)] %></li>
          <li class="nav-item"><%= link_to "Activiy", activities_path, class: ["nav-link", "active": current_page?(activities_path)] %></li>
          <li class="nav-item"><%= link_to "Statistics", statistics_path, class: ["nav-link", "active": current_page?(statistics_path)] %></li>
        </ul>
        <% if user_signed_in? %>
          <div class="dropdown text-end">
            <a href="#" class="d-block link-body-emphasis text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
              <img src="https://www.gravatar.com/avatar/<%= current_user.gravatar_hash %>?d=mp" alt="mdo" width="32" height="32" class="rounded-circle">
            </a>
            <ul class="dropdown-menu dropdown-menu-end text-small account-dropdown-menu" data-bs-theme="light">
              <li><a class="dropdown-item" href="<%= trestle.root_path %>">Admin</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="<%= destroy_user_session_path %>" data-turbo-method="delete">Sign out</a></li>
            </ul>
          </div>
        <% else %>
          <a href="<%= trestle.login_path %>" class="btn btn-outline-primary">Login</a>
        <% end %>
      </div>
    </div>
  </nav>
</header>
