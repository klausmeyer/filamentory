              <li><a class="dropdown-item" href="<%= destroy_user_session_path %>" data-turbo-method="delete">Sign out</a></li>
            </ul>
          </div>
        <% else %>
          <a href="<%= trestle.login_path %>" class="btn btn-outline-primary">Login</a>
        <% end %>
      </div>
    </div>
  </nav>
