<% content_for :title, "Unlink #{oidc_provider_name}" %>

<div class="row justify-content-center">
  <div class="col-lg-6">
    <h1 class="h3 mb-3">Unlink <%= oidc_provider_name %></h1>

    <% if current_user.oidc_identity %>
      <p class="text-body-secondary">
        <%= oidc_provider_name %> is linked to <%= current_user.oidc_identity.email.presence || current_user.oidc_identity.uid %>.
      </p>

      <div class="d-flex gap-2">
        <%= button_to "Unlink #{oidc_provider_name}",
                      users_oidc_link_path,
                      method: :delete,
                      class: "btn btn-danger",
                      form: { data: { turbo: false } } %>
        <%= link_to "Cancel", trestle.auth_account_admin_path, class: "btn btn-outline-secondary" %>
      </div>
    <% else %>
      <p class="text-body-secondary">
        No <%= oidc_provider_name %> account is linked to <%= current_user.email %>.
      </p>

      <%= link_to "Back to account", trestle.auth_account_admin_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
</div>
